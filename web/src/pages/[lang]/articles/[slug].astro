---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { Language } from "../../../i18n/config";
import {
  useTranslations,
  formatDate,
  getLocalizedPath,
} from "../../../i18n/utils";

export async function getStaticPaths() {
  const { getSlugFromEntryId } = await import("../../../i18n/utils");
  const { languages, defaultLang } = await import("../../../i18n/config");
  const articles = await getCollection("articles");

  return languages
    .filter((lang) => lang !== defaultLang)
    .flatMap((lang) =>
      articles
        .filter((a) => !a.data.draft && a.id.startsWith(`${lang}/`))
        .map((entry) => {
          const slug = getSlugFromEntryId(entry.id, lang);
          return {
            params: { lang, slug },
            props: { entry, lang },
          };
        })
    );
}

interface Props {
  entry: Awaited<ReturnType<typeof getCollection>>[number];
  lang: Language;
}

const { entry, lang } = Astro.props;
const { Content } = await entry.render();
const t = useTranslations(lang);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  lang={lang}
>
  <article>
    <header class="mb-8">
      <time
        datetime={entry.data.publishedAt.toISOString()}
        class="text-sm text-gray-500"
      >
        {formatDate(entry.data.publishedAt, lang)}
      </time>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">
        {entry.data.title}
      </h1>
      <p class="mt-3 text-lg text-gray-600">{entry.data.summary}</p>
    </header>
    <div class="prose prose-gray max-w-none">
      <Content />
    </div>
  </article>
  <div class="mt-10 border-t border-gray-200 pt-6">
    <a
      href={getLocalizedPath("/", lang)}
      class="text-sm text-gray-500 hover:text-gray-700"
    >
      &larr; {t("articles.back")}
    </a>
  </div>
</BaseLayout>
