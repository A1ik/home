---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { languages, defaultLang } from "../../i18n/config";
import type { Language } from "../../i18n/config";
import { useTranslations, getSlugFromEntryId } from "../../i18n/utils";

export async function getStaticPaths() {
  return languages
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Language };
const t = useTranslations(lang);

const articles = (await getCollection("articles"))
  .filter((a) => !a.data.draft && a.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title={t("nav.home")} lang={lang}>
  <h1 class="text-3xl font-bold tracking-tight">{t("articles.heading")}</h1>
  {
    articles.length > 0 ? (
      <div class="mt-6 divide-y divide-gray-200">
        {articles.map((article) => (
          <ArticleCard
            title={article.data.title}
            slug={getSlugFromEntryId(article.id, lang)}
            publishedAt={article.data.publishedAt}
            summary={article.data.summary}
            lang={lang}
          />
        ))}
      </div>
    ) : (
      <p class="mt-6 text-gray-500">{t("articles.empty")}</p>
    )
  }
</BaseLayout>
