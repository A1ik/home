---
export const prerender = false;

import { getDb } from "../../db/client";
import { gdeltEvents } from "../../db/schema";
import { eq, desc } from "drizzle-orm";

const url = new URL(Astro.request.url);
const success = url.searchParams.get("success");
const error = url.searchParams.get("error");

let events: (typeof gdeltEvents.$inferSelect)[] = [];
let dbError = "";

try {
  const d1 = Astro.locals.runtime.env.DB;
  const db = getDb(d1);
  events = await db
    .select()
    .from(gdeltEvents)
    .where(eq(gdeltEvents.processed, 0))
    .orderBy(desc(gdeltEvents.created_at))
    .limit(50);
} catch (e) {
  dbError = e instanceof Error ? e.message : "Failed to connect to D1";
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GDELT News Dashboard</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-gray-50 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 py-8">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">GDELT News Dashboard</h1>
        <a
          href="/keystatic"
          class="text-sm text-blue-600 hover:text-blue-800 underline"
        >
          Keystatic Admin
        </a>
      </div>

      {
        success && (
          <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 rounded-md text-sm">
            Article promoted to draft successfully.
          </div>
        )
      }

      {
        error && (
          <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 rounded-md text-sm">
            Error: {decodeURIComponent(error)}
          </div>
        )
      }

      {
        dbError && (
          <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 rounded-md text-sm">
            Database error: {dbError}
          </div>
        )
      }

      {
        events.length === 0 && !dbError && (
          <p class="text-gray-500">No unprocessed news items found.</p>
        )
      }

      {
        events.length > 0 && (
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Title
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Date
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Source
                  </th>
                  <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                {events.map((event) => (
                  <tr class="hover:bg-gray-50">
                    <td
                      class="px-4 py-3 text-sm text-gray-900 max-w-xs truncate"
                      title={event.title}
                    >
                      {event.title}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500 whitespace-nowrap">
                      {event.publish_date || "N/A"}
                    </td>
                    <td class="px-4 py-3 text-sm">
                      <a
                        href={event.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-blue-600 hover:text-blue-800 underline"
                      >
                        Link
                      </a>
                    </td>
                    <td class="px-4 py-3 text-right">
                      <form
                        action="/api/promote"
                        method="POST"
                        class="flex items-center justify-end gap-2"
                      >
                        <input type="hidden" name="id" value={event.id} />
                        <select
                          name="lang"
                          class="block w-20 rounded border-gray-300 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500"
                        >
                          <option value="en" selected>
                            EN
                          </option>
                          <option value="ru">RU</option>
                          <option value="uk">UK</option>
                        </select>
                        <button
                          type="submit"
                          class="inline-flex items-center px-3 py-1.5 text-xs font-medium rounded bg-blue-600 text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1"
                        >
                          Promote to Draft
                        </button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </div>
  </body>
</html>
