{
  "name": "doichev-com",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "worker",
    "web"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:worker": "npm run typecheck -w worker",
    "typecheck:web": "npm run typecheck -w web",
    "test:worker": "npm run test -w worker",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "astro-eslint-parser": "^1.3.0",
    "eslint": "^10.0.2",
    "eslint-plugin-astro": "^1.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.56.1"
  }
}
